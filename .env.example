# Database Configuration
# MongoDB connection string (e.g., mongodb+srv://username:password@cluster.mongodb.net/dbname)
DB_URL=

# Server Configuration
# Application environment ('development', 'production', or 'test')
NODE_ENV=development
# Port number the server listens on (e.g., 5000)
PORT=5000

# Client Configuration
# Frontend application URL for CORS and redirect links (e.g., http://localhost:3000)
CLIENT_URL=http://localhost:3000,http://localhost:5173 # Add more URLs as needed, separated by commas

# Security Configuration (Argon2 Password Hashing Parameters)
# Memory cost in kibibytes (e.g., 65536 for 64MB)
ARGON2_MEMORY=65536
# Number of iterations / time cost (e.g., 3)
ARGON2_TIME=3
# Degree of parallelism / number of threads (e.g., 4)
ARGON2_PARALLELISM=4

# JWT Configuration
# Secret key for signing access tokens (use a strong random string)
JWT_ACCESS_SECRET=your_super_secret_access_key_here
# Access token lifespan (e.g., 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Secret key for signing refresh tokens (use a different strong random string)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
# Refresh token lifespan (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Resend Service)
# API key provided by Resend
RESEND_API_KEY=re_your_api_key_here
# Sender email address displayed to users (e.g., onno <noreply@yourdomain.com>)
EMAIL_FROM=onno <noreply@yourdomain.com>

# Token Expiration Configuration
# Lifespan of the email verification token (e.g., 30m, 1h)
EMAIL_VERIFICATION_EXPIRES_IN=30m
# Lifespan of the password reset token (e.g., 15m, 1h)
PASSWORD_RESET_EXPIRES_IN=15m