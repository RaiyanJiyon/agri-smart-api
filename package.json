{
  "name": "agri-smart-api",
  "version": "1.0.0",
  "description": "Backend API for Agri Smart platform",
  "main": "dist/server.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "test": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs",
    "test:run": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs --watch",
    "test:coverage": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run --coverage",
    "test:unit": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/e2e",
    "docker:build": "docker build -t agri-smart-api .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "api",
    "express",
    "agriculture",
    "smart-farming"
  ],
  "author": "Raiyan Jiyon",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@mistralai/mistralai": "^2.6.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.18.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "~5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
