{
  "name": "agri-smart-api",
  "version": "1.0.0",
  "description": "Backend API for Agri Smart platform",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/app.ts",
    "start": "node --env-file=.env dist/app.js",
    "build": "tsc -p tsconfig.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "api",
    "express",
    "agriculture",
    "smart-farming"
  ],
  "author": "Raiyan Jiyon",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "~5.0.6",
    "@types/node": "^26.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
